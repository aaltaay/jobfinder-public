{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobs.example.com/schemas/agent-registry.json",
  "title": "Job Finder agent registry",
  "type": "object",
  "required": ["schema_version", "agents"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "updated_at": { "type": "string" },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "spec",
        "memory",
        "invoke_phrases",
        "writable_paths",
        "domain"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "name": { "type": "string" },
        "spec": { "type": "string" },
        "memory": { "type": "string" },
        "invoke_phrases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "dashboard": { "type": "object" },
        "continuity_rule": { "type": ["string", "null"] },
        "continuity_waiver": { "type": ["string", "null"] },
        "canonical_inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "prohibited_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deterministic_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sibling_handoffs": { "type": "object" },
        "domain": { "type": "string", "minLength": 3 }
      }
    }
  }
}
