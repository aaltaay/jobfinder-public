# Job Finder — environment variables (public portfolio extract)
# Copy to apps/jobfinder/.env.local for local SPA development.

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_DB_SCHEMA=schema_jobfinder

# Optional: Google Drive picker for résumé import
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
# VITE_GOOGLE_APP_ID=

# --- Supabase Edge Function secrets (set via: npx supabase secrets set) ---
# Server-only — never expose as VITE_* / NEXT_PUBLIC_*
JOB_WEBHOOK_SECRET=
JOBFINDER_OWNER_USER_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# GitHub Actions (services/job-discovery workflow)
# JOB_INGEST_URL=https://your-supabase-project-ref.supabase.co/functions/v1/job-ingest
# JOB_INGEST_ANON_KEY=<same anon key as above>
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- E2E smoke (scripts/e2e_jobfinder.mjs) ---
# JOBFINDER_URL=https://jobs.example.com
# JOBFINDER_PASSWORD=demo-password
# JOBFINDER_EMAIL=demo@example.com
